# ── LLM (optional; pipeline runs without these) ─────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_SCHEMA_MODEL=qwen/qwen-2.5-7b-instruct
LLM_EXTRACT_MODEL=qwen/qwen3-30b-a3b
LLM_MAX_RETRIES=3

# ── Feature flags ────────────────────────────────────────────────────────────
ENABLE_NER=1
ENABLE_LLM=1

# ── NER ─────────────────────────────────────────────────────────────────────
GLINER_MODEL=urchade/gliner_multi-v2.1

# ── Confidence thresholds ───────────────────────────────────────────────────
CONFIDENCE_FLAG_THRESHOLD=0.6

# ── API server ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false
MAX_UPLOAD_BYTES=52428800
